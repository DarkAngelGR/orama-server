# ==============================================================================
# Hermes 2.0 — Mini-PC Deployment Configuration (.env / hermes.env)
# ==============================================================================
# Copy this file to 'hermes.env' on your Mini-PC:
#   cp hermes.env.example hermes.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Network Binding
# ------------------------------------------------------------------------------
# Custom friendly node identifier (displayed in telemetry and dashboard)
NODE_NAME="Hermes Companion Node"

# Secret Bearer token for Hermes API (required, must be 32+ random characters).
# Generate on Linux/Mac: openssl rand -hex 24
# Generate on Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
HERMES_API_KEY=change_me_to_at_least_32_random_characters_secret_key

# Bind to 0.0.0.0 so you can access the Hermes dashboard from any device on your LAN
HERMES_BIND_IP=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Media Stack Connectivity
# ------------------------------------------------------------------------------
# Supports: private LAN IP, Docker service names (orama, plex, jellyfin),
# or local domains (.local, .lan, .home, .internal, .ts.net, .home.arpa).

# Orama Server URL (used for direct media requests and health probing)
ORAMA_URL=http://nas.local:8765

# Plex Media Server
PLEX_URL=http://nas.local:32400
PLEX_TOKEN=

# Jellyfin / Emby (optional)
JELLYFIN_URL=http://nas.local:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# ------------------------------------------------------------------------------
# 3. AI Providers (LLM & Voice)
# ------------------------------------------------------------------------------
# Option A: Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Option B: OpenAI / OpenRouter / vLLM / LM Studio / LocalAI (Any OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C: Local Ollama inference (running on companion node or server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# The Movie Database (TMDB) API key (https://www.themoviedb.org/settings/api)
# Required for fetching movie/series metadata and poster artwork
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 4. Local Neural Voice (Piper) & Discovery Settings
# ------------------------------------------------------------------------------
# Install Piper TTS in container for CPU-only offline speech
INSTALL_LOCAL_TTS=true

# Directory containing Piper ONNX voice models (mounted to /voices in container)
PIPER_MODEL_DIR=/voices

# How often (in hours) Hermes refreshes personalized recommendation picks
REFRESH_HOURS=24
