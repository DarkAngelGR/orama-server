# ==============================================================================
# Orama Server — NAS Configuration Additions (.env)
# ==============================================================================
# Add these variables to your existing Orama environment on your NAS.
# ==============================================================================

# Tell Orama where Hermes lives on your local network (your Mini-PC's LAN IP and port 8787).
# Clicking "Hermes" in Orama's top navigation bar will instantly direct users to Hermes!
HERMES_URL=http://192.168.1.150:8787

# Orama's own state folder and binding
ORAMA_STATE_DIR=/var/lib/orama
ORAMA_BIND_IP=0.0.0.0
