# ==============================================================================
# Orama Server — NAS Configuration Additions (.env)
# ==============================================================================
# Add these variables to your existing Orama environment on your NAS.
# ==============================================================================

# The Hermes link is set in Orama: Settings → Hermes. This file is not loaded
# by the Orama container, so a HERMES_URL line here does nothing.
# Example address: http://mini-pc.local:8787

# Orama's own state folder and binding
ORAMA_STATE_DIR=/var/lib/orama
ORAMA_BIND_IP=0.0.0.0
