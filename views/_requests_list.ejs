<% if (typeof requests !== 'undefined' && requests.length > 0) { %>
  <div style="display: grid; gap: 1rem;">
    <% requests.forEach(function(reqItem) { %>
      <div style="border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; background: var(--surface);">
        <%- include('requests/_status', { reqItem: reqItem }) %>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="notice notice-wait">
    <p>No active requests yet. Search above to request movies or TV shows.</p>
  </div>
<% } %>
