<%- include('layout/header', { title: 'Apps · Orama', activeNav: 'apps' }) %>

<section class="apps">
  <h1>Apps</h1>
  <p class="field-help" style="margin-top: 0.5rem; margin-bottom: 1.5rem;">The apps Orama runs for you. This list refreshes by itself.</p>
  <div id="apps-list" hx-get="/apps/list<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>" hx-trigger="every 10s" hx-swap="innerHTML">
    <%- include('_apps_list') %>
  </div>
</section>

<%- include('layout/footer') %>
