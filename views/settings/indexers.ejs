<%- include('../layout/header', { title: 'Indexers · Settings · Orama', activeNav: 'settings' }) %>

<div class="settings">
  <p><a class="button button-quiet" href="/settings">← Back to Settings</a></p>
  <h1>Indexers & Usenet</h1>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="notice <%- typeof problem !== 'undefined' && problem ? 'notice-problem' : 'notice-ok' %>">
      <p><%= message %></p>
    </div>
  <% } %>

  <section class="settings-section">
    <h2>Current indexers</h2>
    <% if (setup.indexers && setup.indexers.length > 0) { %>
    <ul class="app-list">
      <% setup.indexers.forEach(function(indexer) { %>
      <li class="app-row">
        <span class="app-name"><%= indexer.name %></span>
        <form method="post" action="/settings/indexers/<%= indexer.slug %>/test" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="button button-secondary">Test</button>
        </form>
        <form method="post" action="/settings/indexers/<%= indexer.slug %>/remove" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="button button-secondary">Remove</button>
        </form>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p>No indexers added yet.</p>
    <% } %>

    <h3 style="margin-top: 1.5rem;">Add an indexer</h3>
    <form method="post" action="/settings/indexers" class="wizard-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="field">
        <label for="indexer_name">Indexer name</label>
        <input id="indexer_name" name="name" type="text" required placeholder="e.g. 1337x, Geek, etc.">
      </div>
      <div class="field">
        <label for="indexer_url">URL</label>
        <input id="indexer_url" name="url" type="url" required placeholder="https://...">
      </div>
      <div class="field">
        <label for="indexer_key">API Key (if required)</label>
        <input id="indexer_key" name="api_key" type="password">
      </div>
      <div class="wizard-actions">
        <button type="submit" class="button button-primary">Add indexer</button>
      </div>
    </form>
  </section>

  <% if (setup.download_methods && setup.download_methods.includes('usenet')) { %>
  <section class="settings-section">
    <h2>Usenet servers</h2>
    <% if (setup.usenet_servers && setup.usenet_servers.length > 0) { %>
    <ul class="app-list">
      <% setup.usenet_servers.forEach(function(server) { %>
      <li class="app-row">
        <span class="app-name"><%= server.host %> (<%= server.port %>)</span>
        <form method="post" action="/settings/usenet/<%= server.slug %>/test" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="button button-secondary">Test</button>
        </form>
        <form method="post" action="/settings/usenet/<%= server.slug %>/remove" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="button button-secondary">Remove</button>
        </form>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p>No Usenet servers configured yet.</p>
    <% } %>

    <h3 style="margin-top: 1.5rem;">Add Usenet server</h3>
    <form method="post" action="/settings/usenet" class="wizard-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="field">
        <label for="server_host">Host</label>
        <input id="server_host" name="host" type="text" required placeholder="news.example.com">
      </div>
      <div class="field">
        <label for="server_port">Port</label>
        <input id="server_port" name="port" type="number" value="563" required>
      </div>
      <div class="field">
        <label for="server_user">Username</label>
        <input id="server_user" name="username" type="text">
      </div>
      <div class="field">
        <label for="server_pass">Password</label>
        <input id="server_pass" name="password" type="password">
      </div>
      <div class="wizard-actions">
        <button type="submit" class="button button-primary">Add server</button>
      </div>
    </form>
  </section>
  <% } %>
</div>

<%- include('../layout/footer') %>
