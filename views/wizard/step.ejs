<%- include('../layout/header', { title: title + ' · Setup · Orama', activeNav: '' }) %>

<div class="wizard">
  <div class="wizard-progress">Step <%= stepIndex %> of <%= totalSteps %>: <%= stepName %></div>
  <h1><%= title %></h1>
  <p class="wizard-lead"><%= lead %></p>

  <form method="post" action="/setup/<%= stepKey %>" class="wizard-form">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

    <% if (stepKey === 'media') { %>
      <div class="wizard-group">
        <h2>Choose your media servers</h2>
        <div class="choices">
          <label class="choice">
            <input type="checkbox" name="server_plex" value="1" <%- setup.media_servers.includes('plex') ? 'checked' : '' %>>
            <span><strong>Plex</strong> — Rich metadata, cross-device sync, and wide client support.</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="server_jellyfin" value="1" <%- setup.media_servers.includes('jellyfin') ? 'checked' : '' %>>
            <span><strong>Jellyfin</strong> — Fully open-source, local-first streaming server.</span>
          </label>
        </div>
      </div>
    <% } else if (stepKey === 'folders') { %>
      <div class="wizard-group">
        <h2>Storage locations</h2>
        <div class="field">
          <label for="media_dir">Media library folder</label>
          <input id="media_dir" name="media_dir" type="text" value="<%= setup.media_dir || '/data/media' %>" required>
        </div>
        <div class="field">
          <label for="downloads_dir">Downloads folder</label>
          <input id="downloads_dir" name="downloads_dir" type="text" value="<%= setup.downloads_dir || '/data/downloads' %>" required>
        </div>
      </div>
    <% } else if (stepKey === 'downloads') { %>
      <div class="wizard-group">
        <h2>Download methods</h2>
        <div class="choices">
          <label class="choice">
            <input type="checkbox" name="torrent" value="1" <%- setup.download_methods.includes('torrent') ? 'checked' : '' %>>
            <span><strong>Torrents (qBittorrent)</strong> — Peer-to-peer distribution.</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="usenet" value="1" <%- setup.download_methods.includes('usenet') ? 'checked' : '' %>>
            <span><strong>Usenet (SABnzbd)</strong> — High-speed direct downloads.</span>
          </label>
        </div>
      </div>
      <div class="wizard-group">
        <h2>VPN Protection (Gluetun)</h2>
        <div class="field">
          <label for="vpn_provider">VPN Provider</label>
          <select id="vpn_provider" name="vpn_provider">
            <option value="none" <%- !setup.vpn ? 'selected' : '' %>>None (Direct connection)</option>
            <option value="ProtonVPN" <%- setup.vpn && setup.vpn.provider === 'ProtonVPN' ? 'selected' : '' %>>ProtonVPN (WireGuard / Port Forwarding)</option>
            <option value="Mullvad" <%- setup.vpn && setup.vpn.provider === 'Mullvad' ? 'selected' : '' %>>Mullvad</option>
            <option value="AirVPN" <%- setup.vpn && setup.vpn.provider === 'AirVPN' ? 'selected' : '' %>>AirVPN</option>
          </select>
        </div>
      </div>
    <% } else if (stepKey === 'playback') { %>
      <div class="wizard-group">
        <h2>Primary playback device profile</h2>
        <p class="field-help">Optimizes Recyclarr media formatting to avoid transcoding.</p>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="playback_profile" value="safest" <%- setup.playback_profile === 'safest' ? 'checked' : '' %>>
            <span><strong>Safest compatibility</strong> — Maximum compatibility across all web and smart TVs.</span>
          </label>
          <label class="choice">
            <input type="radio" name="playback_profile" value="apple_tv" <%- setup.playback_profile === 'apple_tv' ? 'checked' : '' %>>
            <span><strong>Apple TV 4K</strong> — Infuse / native direct play.</span>
          </label>
          <label class="choice">
            <input type="radio" name="playback_profile" value="nvidia_shield" <%- setup.playback_profile === 'nvidia_shield' ? 'checked' : '' %>>
            <span><strong>Nvidia Shield Pro</strong> — Full lossless audio and Dolby Vision bitstreaming.</span>
          </label>
        </div>
      </div>
    <% } else if (stepKey === 'subtitles') { %>
      <div class="wizard-group">
        <h2>Subtitle automation (Bazarr)</h2>
        <div class="field">
          <label for="subtitles_language">Default subtitle language</label>
          <select id="subtitles_language" name="subtitles_language">
            <option value="en" selected>English</option>
            <option value="es">Spanish</option>
            <option value="fr">French</option>
            <option value="de">German</option>
            <option value="el">Greek</option>
          </select>
        </div>
      </div>
    <% } else if (stepKey === 'review') { %>
      <div class="wizard-group">
        <h2>Review your Orama configuration</h2>
        <dl class="settings-facts">
          <dt>Media servers</dt>
          <dd><%= setup.media_servers.join(', ') || 'None' %></dd>
          <dt>Download clients</dt>
          <dd><%= setup.download_methods.join(', ') || 'None' %></dd>
          <dt>VPN</dt>
          <dd><%= setup.vpn ? setup.vpn.provider : 'None' %></dd>
          <dt>Playback profile</dt>
          <dd><%= setup.playback_profile || 'safest' %></dd>
        </dl>
      </div>
    <% } %>

    <div class="wizard-actions" style="margin-top: 1.5rem;">
      <% if (prevUrl) { %>
        <a class="button button-secondary" href="<%= prevUrl %>">Back</a>
      <% } %>
      <button type="submit" class="button button-primary">
        <%= stepKey === 'review' ? 'Apply & Complete' : 'Save & Continue' %>
      </button>
    </div>
  </form>
</div>

<%- include('../layout/footer') %>
