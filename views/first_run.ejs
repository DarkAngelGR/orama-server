<%- include('layout/header', { title: 'Welcome · Orama', activeNav: '' }) %>

<div class="entry-layout">
  <section class="entry-intro">
    <h1>A home for your media.</h1>
    <p>Connect your apps, choose how you watch, and let Orama bring it all together.</p>
  </section>
  <section class="entry-panel" aria-labelledby="welcome-title">
    <h2 id="welcome-title">Welcome to Orama</h2>
    <% if (typeof error !== 'undefined' && error) { %>
      <div id="password-error" class="notice notice-problem">
        <p><%= error %></p>
      </div>
    <% } %>
    <p>First, create an admin password to keep your setup yours.</p>
    <form action="/setup/password" method="post" class="form-stack">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="field">
        <label for="password">Create your Orama password</label>
        <p id="password-help" class="field-help">Use at least 12 characters. A few memorable words work well.</p>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required>
      </div>
      <button class="button button-primary" type="submit">Create password</button>
    </form>
  </section>
</div>

<%- include('layout/footer') %>
