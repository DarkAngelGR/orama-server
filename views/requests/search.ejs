<%- include('../layout/header', { title: 'Search Media · Orama', activeNav: 'home' }) %>

<div class="settings">
  <p><a class="button button-quiet" href="/<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>">← Back to Home</a></p>
  <h1>Search & Request Media</h1>
  <p class="field-help" style="margin-top: 0.25rem; margin-bottom: 1.5rem;">Find movies and series to request across Radarr and Sonarr.</p>

  <form method="get" action="/search" class="wizard-form" style="margin-bottom: 2rem;">
    <% if (typeof token !== 'undefined' && token) { %>
      <input type="hidden" name="token" value="<%= token %>">
    <% } %>
    <div class="field">
      <label for="q">Search query</label>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <input id="q" name="q" type="text" value="<%= typeof query !== 'undefined' ? query : '' %>" placeholder="Title, e.g. Dune, Severance..." required style="flex: 1 1 16rem;">
        <select name="type" style="width: auto; min-width: 8rem;">
          <option value="all" <%- typeof type === 'undefined' || type === 'all' ? 'selected' : '' %>>All types</option>
          <option value="movie" <%- typeof type !== 'undefined' && type === 'movie' ? 'selected' : '' %>>Movies</option>
          <option value="series" <%- typeof type !== 'undefined' && type === 'series' ? 'selected' : '' %>>TV Series</option>
        </select>
        <button type="submit" class="button button-primary">Search</button>
      </div>
    </div>
  </form>

  <% if (typeof results !== 'undefined' && results.length > 0) { %>
    <h2>Search results (<%= results.length %>)</h2>
    <div style="display: grid; gap: 1rem; margin-top: 1rem;">
      <% results.forEach(function(item) { %>
        <div class="settings-section" style="display: flex; gap: 1.25rem; flex-direction: row; align-items: flex-start; flex-wrap: wrap;">
          <% if (item.poster_url) { %>
            <img src="<%= item.poster_url %>" alt="<%= item.title %> poster" style="width: 90px; height: 135px; object-fit: cover; border-radius: 0.5rem; border: 1px solid var(--line); flex-shrink: 0;" onerror="this.style.display='none'">
          <% } %>
          <div style="flex: 1 1 16rem; min-width: 0;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
              <h3 style="margin: 0; font-size: 1.2rem;">
                <%= item.title %>
                <% if (item.year) { %><span style="color: var(--muted); font-weight: normal; font-size: 1rem;"> (<%= item.year %>)</span><% } %>
              </h3>
              <span class="app-state" style="text-transform: capitalize; font-size: 0.85rem; padding: 0.2rem 0.5rem; background: var(--canvas); border-radius: 0.3rem;"><%= item.kind %></span>
            </div>

            <p style="margin-top: 0.5rem; font-size: 0.95rem; color: var(--muted); line-height: 1.5;">
              <%= item.overview || 'No description available.' %>
            </p>

            <div style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
              <a class="button button-secondary" style="min-height: 42px; padding: 0.5rem 1rem;" href="/media/<%= item.kind %>/<%= item.source_id %><%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>">
                View Seasons & Episodes
              </a>

              <form method="post" action="/requests" style="margin: 0;">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <% if (typeof token !== 'undefined' && token) { %>
                  <input type="hidden" name="token" value="<%= token %>">
                <% } %>
                <input type="hidden" name="kind" value="<%= item.kind %>">
                <input type="hidden" name="source_id" value="<%= item.source_id %>">
                <input type="hidden" name="title" value="<%= item.title %>">
                <input type="hidden" name="year" value="<%= item.year || '' %>">
                <button type="submit" class="button button-primary" style="min-height: 42px; padding: 0.5rem 1rem;">
                  Request <%= item.kind === 'movie' ? 'Movie' : 'Series' %>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else if (typeof query !== 'undefined' && query) { %>
    <div class="notice notice-wait">
      <p>No results found for "<%= query %>". Try searching with another title.</p>
    </div>
  <% } %>
</div>

<%- include('../layout/footer') %>
