<div class="request-card" id="request-<%= reqItem.id %>">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
    <div>
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 650;">
        <a href="/requests/<%= reqItem.id %><%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>" style="color: var(--ink); text-decoration: none;">
          <%= reqItem.title %>
        </a>
        <% if (reqItem.year) { %><span style="color: var(--muted); font-weight: normal; font-size: 0.95rem;"> (<%= reqItem.year %>)</span><% } %>
      </h3>
      <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; font-size: 0.875rem;">
        <span style="text-transform: capitalize; color: var(--muted);"><%= reqItem.kind %></span>
        <% if (reqItem.season) { %><span style="color: var(--muted);">· Season <%= reqItem.season %></span><% } %>
        <% if (reqItem.episode) { %><span style="color: var(--muted);">· Episode <%= reqItem.episode %></span><% } %>
      </div>
    </div>

    <div>
      <% if (reqItem.stage === 'Ready') { %>
        <span class="app-state" style="color: var(--ok); background: var(--ok-bg); padding: 0.25rem 0.65rem; border-radius: 0.35rem;">Ready</span>
      <% } else if (reqItem.stage === 'Downloading') { %>
        <span class="app-state" style="color: var(--accent); background: var(--canvas); padding: 0.25rem 0.65rem; border-radius: 0.35rem; border: 1px solid var(--control-border);">Downloading <%= reqItem.progress %>%</span>
      <% } else if (reqItem.stage === 'Importing') { %>
        <span class="app-state" style="color: var(--wait); background: var(--wait-bg); padding: 0.25rem 0.65rem; border-radius: 0.35rem;">Importing</span>
      <% } else { %>
        <span class="app-state" style="color: var(--muted); background: var(--canvas); padding: 0.25rem 0.65rem; border-radius: 0.35rem;">Searching</span>
      <% } %>
    </div>
  </div>

  <% if (reqItem.stage === 'Downloading') { %>
    <div style="margin-top: 0.75rem; background: var(--canvas); height: 8px; border-radius: 4px; overflow: hidden; border: 1px solid var(--line);">
      <div style="background: var(--accent); height: 100%; width: <%= reqItem.progress %>%; transition: width 0.4s ease;"></div>
    </div>
  <% } %>

  <div style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--muted); display: grid; gap: 0.25rem;">
    <% if (reqItem.waiting_reason && reqItem.stage === 'Searching') { %>
      <div>⏳ <%= reqItem.waiting_reason %></div>
    <% } %>
    <% if (reqItem.playback_note) { %>
      <div>🎬 <%= reqItem.playback_note %></div>
    <% } %>
    <% if (reqItem.subtitle_note) { %>
      <div>💬 <%= reqItem.subtitle_note %></div>
    <% } %>
  </div>

  <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <a class="button button-secondary" style="min-height: 38px; padding: 0.4rem 0.8rem; font-size: 0.9rem;" href="/requests/<%= reqItem.id %><%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>">Details</a>
    <% if (reqItem.stage === 'Ready') { %>
      <a class="button button-primary" style="min-height: 38px; padding: 0.4rem 0.8rem; font-size: 0.9rem;" href="http://localhost:8096" target="_blank" rel="noopener noreferrer">Watch on Jellyfin</a>
    <% } %>
    <form method="post" action="/requests/<%= reqItem.id %>/delete" style="margin: 0; margin-left: auto;">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <% if (typeof token !== 'undefined' && token) { %>
        <input type="hidden" name="token" value="<%= token %>">
      <% } %>
      <button type="submit" class="button button-quiet" style="min-height: 38px; padding: 0.4rem 0.6rem; font-size: 0.85rem; color: var(--problem);">Cancel</button>
    </form>
  </div>
</div>
