<%- include('../layout/header', { title: media.title + ' · Media Detail · Orama', activeNav: 'home' }) %>

<div class="settings">
  <p><a class="button button-quiet" href="/search<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>">← Back to Search</a></p>

  <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: flex-start;">
    <% if (media.poster_url) { %>
      <img src="<%= media.poster_url %>" alt="<%= media.title %> poster" style="width: 140px; height: 210px; object-fit: cover; border-radius: 0.5rem; border: 1px solid var(--line); flex-shrink: 0;" onerror="this.style.display='none'">
    <% } %>

    <div style="flex: 1 1 16rem; min-width: 0;">
      <h1 style="margin: 0;"><%= media.title %></h1>
      <p class="field-help" style="margin-top: 0.25rem;">
        <span style="text-transform: capitalize;"><%= media.kind %></span>
        <% if (media.year) { %> · <%= media.year %><% } %>
      </p>

      <p style="margin-top: 0.75rem; font-size: 1rem; color: var(--muted); line-height: 1.5;">
        <%= media.overview %>
      </p>

      <div style="margin-top: 1.25rem;">
        <form method="post" action="/requests" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <% if (typeof token !== 'undefined' && token) { %>
            <input type="hidden" name="token" value="<%= token %>">
          <% } %>
          <input type="hidden" name="kind" value="<%= media.kind %>">
          <input type="hidden" name="source_id" value="<%= media.source_id %>">
          <input type="hidden" name="title" value="<%= media.title %>">
          <input type="hidden" name="year" value="<%= media.year || '' %>">
          <button type="submit" class="button button-primary">
            Request <%= media.kind === 'movie' ? 'Entire Movie' : 'Entire Series' %>
          </button>
        </form>
      </div>
    </div>
  </div>

  <% if (media.kind === 'series' && media.seasons && media.seasons.length > 0) { %>
    <section class="settings-section" style="margin-top: 2rem;">
      <h2>Seasons & Episodes</h2>
      <p class="field-help">Request specific seasons or individual episodes without monitoring the whole series.</p>

      <div style="display: grid; gap: 1rem; margin-top: 1rem;">
        <% media.seasons.forEach(function(s) { %>
          <div style="border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; background: var(--canvas);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <h3 style="margin: 0; font-size: 1.1rem;"><%= s.name %> (<%= s.episodes.length %> episodes)</h3>
              <form method="post" action="/requests" style="margin: 0;">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <% if (typeof token !== 'undefined' && token) { %>
                  <input type="hidden" name="token" value="<%= token %>">
                <% } %>
                <input type="hidden" name="kind" value="season">
                <input type="hidden" name="source_id" value="<%= media.source_id %>">
                <input type="hidden" name="title" value="<%= media.title %>">
                <input type="hidden" name="year" value="<%= media.year || '' %>">
                <input type="hidden" name="season" value="<%= s.season_number %>">
                <button type="submit" class="button button-secondary" style="min-height: 38px; padding: 0.4rem 0.8rem; font-size: 0.875rem;">
                  Request Season <%= s.season_number %>
                </button>
              </form>
            </div>

            <ul style="list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.5rem;">
              <% s.episodes.slice(0, 5).forEach(function(ep) { %>
                <li style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.6rem; background: var(--surface); border-radius: 0.35rem; font-size: 0.9rem;">
                  <span>E<%= ep.episode_number %>: <%= ep.title %></span>
                  <form method="post" action="/requests" style="margin: 0;">
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <% if (typeof token !== 'undefined' && token) { %>
                      <input type="hidden" name="token" value="<%= token %>">
                    <% } %>
                    <input type="hidden" name="kind" value="episode">
                    <input type="hidden" name="source_id" value="<%= media.source_id %>">
                    <input type="hidden" name="title" value="<%= media.title %>">
                    <input type="hidden" name="year" value="<%= media.year || '' %>">
                    <input type="hidden" name="season" value="<%= s.season_number %>">
                    <input type="hidden" name="episode" value="<%= ep.episode_number %>">
                    <button type="submit" class="button button-quiet" style="padding: 0.2rem 0.5rem; min-height: 30px; font-size: 0.8rem;">
                      Request Ep <%= ep.episode_number %>
                    </button>
                  </form>
                </li>
              <% }); %>
            </ul>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>
</div>

<%- include('../layout/footer') %>
